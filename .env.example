DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

SINGPASS_CLIENT_ID=
SINGPASS_CLIENT_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

SINGPOST_API_KEY=

SESSION_SECRET=change-me-in-production
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

SENTRY_DSN=
PORT=3000
NODE_ENV=development

# --- PULSE local data layer (vertical slice) ---
# SQLite = customer/identity truth (Azure SQL equivalent)
SQLITE_PATH=./data/pulse-customers.db

# Document store = CPF knowledge + behavioural docs (MongoDB / Cosmos DB model).
# DOC_STORE_BACKEND: "file" (embedded, default, runs with no server) or "mongo".
DOC_STORE_BACKEND=file
DOC_STORE_PATH=./data/docstore
MONGODB_URI=
MONGODB_DB=pulse

# --- LLM (OpenAI-compatible; default targets z.ai GLM coding endpoint) ---
LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.6
LLM_TIMEOUT_MS=30000

# --- Rate limiting (per IP, per minute). Raise for heavy interactive use. ---
RATE_LIMIT_ANONYMOUS=300
RATE_LIMIT_AUTHENTICATED=600
RATE_LIMIT_WINDOW_MS=60000

# --- Integrated chatbot: AI provider (swappable, one active at a time) ---
# AI_PROVIDER: "zai" (z.ai GLM via LLM_* above) or "hermes" (placeholder until wired)
AI_PROVIDER=zai
# Hermes.AI on the VPS — placeholder until fully integrated (OpenAI-compatible).
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes

# --- Messaging escalation channel (Telegram now, WhatsApp later; swappable) ---
# MESSAGING_CHANNEL: "telegram" (prototype) or "whatsapp" (live, stub)
MESSAGING_CHANNEL=telegram
# TELEGRAM_MODE: "polling" (dev, no public URL needed) or "webhook" (prod)
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=
# Optional: chat id that receives a ping when a new escalation is created.
TELEGRAM_OFFICER_CHAT_ID=
# WhatsApp Cloud API — placeholder until live rollout.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- GitHub auto-deploy webhook (POST /webhook/github) ---
# Generate with: openssl rand -hex 32
# Must match the secret set in GitHub → Settings → Webhooks
GITHUB_WEBHOOK_SECRET=
