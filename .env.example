DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

SINGPASS_CLIENT_ID=
SINGPASS_CLIENT_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

SINGPOST_API_KEY=

SESSION_SECRET=change-me-in-production
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

SENTRY_DSN=
PORT=3000
NODE_ENV=development

# --- PULSE local data layer (vertical slice) ---
# SQLite = customer/identity truth (Azure SQL equivalent)
SQLITE_PATH=./data/pulse-customers.db

# Document store = CPF knowledge + behavioural docs (MongoDB / Cosmos DB model).
# DOC_STORE_BACKEND: "file" (embedded, default, runs with no server) or "mongo".
DOC_STORE_BACKEND=file
DOC_STORE_PATH=./data/docstore
MONGODB_URI=
MONGODB_DB=pulse

# --- LLM (OpenAI-compatible; default targets z.ai GLM coding endpoint) ---
LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.6
LLM_TIMEOUT_MS=30000

# --- Rate limiting (per IP, per minute). Raise for heavy interactive use. ---
RATE_LIMIT_ANONYMOUS=300
RATE_LIMIT_AUTHENTICATED=600
RATE_LIMIT_WINDOW_MS=60000
