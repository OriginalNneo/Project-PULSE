FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
COPY src/python-bridge/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY src/python-bridge/transcriber.py .
EXPOSE 5001
CMD ["uvicorn", "transcriber:app", "--host", "0.0.0.0", "--port", "5001"]
