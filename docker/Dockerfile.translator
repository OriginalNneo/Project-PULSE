FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
COPY src/python-bridge/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY src/python-bridge/translator.py .
EXPOSE 5002
CMD ["uvicorn", "translator:app", "--host", "0.0.0.0", "--port", "5002"]
